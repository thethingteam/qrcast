{
  "name": "@thethingteam/qrcast",
  "version": "0.0.0",
  "description": "Send a Uint8Array from screen to camera with animated codes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thethingteam/qrcast.git",
    "directory": "packages/qrcast"
  },
  "homepage": "https://github.com/thethingteam/qrcast#readme",
  "bugs": {
    "url": "https://github.com/thethingteam/qrcast/issues"
  },
  "keywords": [
    "qr",
    "qrcode",
    "cimbar",
    "air-gap",
    "offline",
    "data-transfer",
    "animated-qr",
    "webassembly"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sender": {
      "types": "./dist/sender/index.d.ts",
      "default": "./dist/sender/index.js"
    },
    "./receiver": {
      "types": "./dist/receiver/index.d.ts",
      "default": "./dist/receiver/index.js"
    },
    "./cimbar": {
      "types": "./dist/codecs/cimbar/index.d.ts",
      "default": "./dist/codecs/cimbar/index.js"
    },
    "./qr": {
      "types": "./dist/codecs/qr/index.d.ts",
      "default": "./dist/codecs/qr/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "pnpm run typecheck && vitest run && pnpm run check:pack",
    "check:pack": "node scripts/check-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zxing-wasm": "3.1.4"
  }
}
